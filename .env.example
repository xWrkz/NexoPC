# Solo para desarrollo local. En producción siempre se ignora aunque se configure en true.
NEXT_PUBLIC_DEMO_MODE=false

# URL pública del catálogo real.
NEXT_PUBLIC_GRAPHQL_URL=http://nexopc-local.local/graphql
NEXT_PUBLIC_WORDPRESS_URL=http://nexopc-local.local

# Secreto compartido con el backend (mismo valor que NEXOPC_SIGNUP_SECRET en WordPress).
# Mínimo 32 caracteres. Sin él, el registro de clientes y el checkout responden 503.
# Los pagos con Mercado Pago se configuran solo en el backend (MP_ACCESS_TOKEN).
NEXOPC_SIGNUP_SECRET=
